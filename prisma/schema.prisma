generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


model Delivery {
  id              String         @id @default(cuid())
  taskId          String
  projectName     String
  clientName      String
  deliverableType String
  department      String
  senderEmail     String
  primaryEmail    String
  ccEmails        String?
  slackChannel     String?
  slackChannelName String?
  emailSubject     String
  emailContent    String         @db.Text
  slackContent    String?        @db.Text
  wasEdited       Boolean        @default(false)
  sentBy          String
  sentAt          DateTime       @default(now())
  n8nExecutionId  String?
  n8nStatus       String?
  projectListId   String?
  clientFolderId  String?
  // When this delivery is a resend, points to the original Delivery it
  // corrects. Self-FK so we can chain (rare) and so analytics can exclude
  // resends from totals/leaderboard while still surfacing them in the
  // activity log.
  replacesDeliveryId String?
  replaces        Delivery?      @relation("DeliveryReplaces", fields: [replacesDeliveryId], references: [id])
  replacedBy      Delivery[]     @relation("DeliveryReplaces")
  // Snapshot of the user's per-delivery template + subject edits at send
  // time, so a resend can carry forward "what they meant to send" while
  // still picking up corrected form-field values via re-merge.
  editedSnippet   String?        @db.Text
  editedSubject   String?
  /** Feedback Windows value at send time. Used by the client portal to compute
   *  a fallback deadline when no live Feedback Deadline task exists. */
  feedbackWindows String?
  // Identity of the deliverable behind this send: the share task's parent names the deliverable, the share task name carries the variant.
  parentTaskId    String?
  parentTaskName  String?
  shareTaskName   String?
  links           DeliveryLink[]
  confirmations   FeedbackConfirmation[]
  createdAt       DateTime       @default(now())

  @@index([taskId])
  @@index([projectListId])
  @@index([clientFolderId])
  @@index([sentAt])
  @@index([replacesDeliveryId])
}

model DeliveryLink {
  id             String   @id @default(cuid())
  deliveryId     String
  delivery       Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  url            String
  label          String
  linkType       String
  variableName   String?
  projectListId  String
  clientFolderId String

  @@index([deliveryId])
  @@index([projectListId])
}

model Draft {
  id        String   @id @default(cuid())
  taskId    String   @unique
  formData  Json
  savedBy   String
  savedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt
  scheduledFor      DateTime?
  scheduleStatus    String?
  scheduledPayload  Json?

  @@index([taskId])
  @@index([scheduledFor])
}

model TemplateVersion {
  id              String   @id @default(cuid())
  templateTaskId  String
  templateName    String
  snippet         String   @db.Text
  subjectLine     String
  deliverableType String
  department      String
  sender          String
  editedBy        String
  editedAt        DateTime @default(now())
  changeNote      String?

  @@index([templateTaskId])
  @@index([editedAt])
}

model AllowedSender {
  clickupUserId Int      @id
  addedBy       String
  addedAt       DateTime @default(now())

  @@index([addedAt])
}

model ClientPreference {
  clientFolderId       String   @id
  clientName           String
  enabled              Boolean  @default(true)
  warningMessage       String   @db.Text
  destinationLink      String?
  restrictions         String[]
  customBlockedDomains String[]
  /** Optional relabel for the "Google Deliverable Link" review-link field
   *  (e.g. "Box Link" for KeyBank). Null = keep the default label. */
  deliverableLinkLabel String?
  /** Client logo shown in the portal header; any https image URL. */
  logoUrl              String?
  updatedBy            String
  updatedAt            DateTime @updatedAt

  @@index([updatedAt])
}

/** Read-through cache for expensive ClickUp reads (e.g. the dashboard task
 *  list). Survives deploys (unlike the Vercel Data Cache) and is refreshed
 *  on demand via stale-while-revalidate. */
model DashboardCache {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

/** Per-project result of the communications audit scan. One row per project
 *  list so a single-project re-scan (after a fix) updates just that row. */
model AuditResult {
  listId      String   @id
  clientName  String
  projectName String
  data        Json
  scannedAt   DateTime @updatedAt
}

/** One bookmarkable client-portal link per ClickUp client folder. A project
 *  view is a deep link under the same token (/portal/<token>/<listId>).
 *  Rotate by revoking (set revokedAt) and creating a new row. Only one active
 *  (revokedAt null) row per clientFolderId is allowed; the create handler must
 *  revoke existing active rows in the same transaction. */
model PortalAccess {
  id             String    @id @default(cuid())
  clientFolderId String
  clientName     String
  token          String    @unique
  createdBy      String
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?
  views          PortalView[]

  @@index([clientFolderId])
}

/** Confirmed internal Slack channel (#client-project) for a project list.
 *  Written once by a PM (or auto-matched when the crawl is confident). */
model ProjectChannel {
  projectListId String   @id
  channelId     String
  channelName   String
  autoMatched   Boolean  @default(false)
  /** Session email of the PM who confirmed, or "auto-match" when autoMatched is true. */
  confirmedBy   String
  confirmedAt   DateTime @default(now())
}

/** A client pressing "All feedback is in" on a delivery. undoneAt != null
 *  means the confirmation was reversed; the latest row per delivery wins. */
model FeedbackConfirmation {
  id String @id @default(cuid())
  /**
   * Null for a confirmation that stands on a Feedback Deadline task alone: the
   * team completed the share task in ClickUp without sending through the
   * portal, so no Delivery row exists and `feedbackDeadlineTaskId` is the key.
   */
  deliveryId             String?
  delivery               Delivery? @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  projectListId          String?
  deliverableType        String
  feedbackDeadlineTaskId String?
  confirmedAt            DateTime  @default(now())
  confirmedByName        String?
  undoneAt               DateTime?
  slackChannelId         String?
  slackMessageTs         String?

  @@index([deliveryId, confirmedAt(sort: Desc)])
  @@index([feedbackDeadlineTaskId, confirmedAt(sort: Desc)])
  @@index([projectListId])
}

/** Lightweight open tracking for the internal "has the client looked" view. */
model PortalView {
  id         String       @id @default(cuid())
  accessId   String
  access     PortalAccess @relation(fields: [accessId], references: [id], onDelete: Cascade)
  /** No FK on purpose: view history must survive if a delivery row is ever removed. */
  deliveryId String?
  viewedAt   DateTime     @default(now())
  userAgent  String?

  @@index([accessId, viewedAt])
  @@index([deliveryId, viewedAt])
}

/** Idempotency log for client reminders and internal overdue nudges. */
model PortalReminder {
  id         String   @id @default(cuid())
  deliveryId String
  kind       String   // "tomorrow" | "today" | "overdue"
  sentOn     String   // Eastern calendar date "YYYY-MM-DD"
  sentAt     DateTime @default(now())

  @@unique([deliveryId, kind, sentOn])
}

/** Messages clients send through the portal reach-out form. Persisted first so nothing is lost if Slack fails. */
model PortalMessage {
  id            String   @id @default(cuid())
  accessId      String
  projectListId String?
  name          String
  message       String   @db.Text
  createdAt     DateTime @default(now())
  slackOk       Boolean  @default(false)

  @@index([accessId, createdAt])
}
